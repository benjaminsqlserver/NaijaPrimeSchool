@* Primary navigation rendered inside the Radzen sidebar *@

<RadzenPanelMenu class="nps-panel-menu">
    <RadzenPanelMenuItem Text="Dashboard" Icon="dashboard" Path="/" />

    <AuthorizeView Roles="@(Roles.SuperAdmin)">
        <Authorized>
            <RadzenPanelMenuItem Text="User Management" Icon="manage_accounts" Expanded="true">
                <RadzenPanelMenuItem Text="All Users" Icon="people" Path="/users" />
                <RadzenPanelMenuItem Text="Add New User" Icon="person_add" Path="/users/new" />
                <RadzenPanelMenuItem Text="Roles" Icon="admin_panel_settings" Path="/roles" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.SuperAdmin},{Roles.HeadTeacher},{Roles.Teacher}")">
        <Authorized>
            <RadzenPanelMenuItem Text="Academics" Icon="school" Expanded="true">
                <RadzenPanelMenuItem Text="Sessions" Icon="event" Path="/sessions" />
                <RadzenPanelMenuItem Text="Terms" Icon="event_note" Path="/terms" />
                <RadzenPanelMenuItem Text="Classes" Icon="class" Path="/classes" />
                <RadzenPanelMenuItem Text="Subjects" Icon="menu_book" Path="/subjects" />
                <RadzenPanelMenuItem Text="Periods" Icon="schedule" Path="/timetable-periods" />
                <RadzenPanelMenuItem Text="Timetable" Icon="grid_on" Path="/timetable" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.SuperAdmin},{Roles.HeadTeacher}")">
        <Authorized>
            <RadzenPanelMenuItem Text="Family" Icon="family_restroom" Expanded="true">
                <RadzenPanelMenuItem Text="Students" Icon="boy" Path="/students" />
                <RadzenPanelMenuItem Text="Add Student" Icon="person_add" Path="/students/new" />
                <RadzenPanelMenuItem Text="Parents" Icon="people_outline" Path="/parents" />
                <RadzenPanelMenuItem Text="Add Parent" Icon="group_add" Path="/parents/new" />
                <RadzenPanelMenuItem Text="Enrolments" Icon="how_to_reg" Path="/enrolments" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.SuperAdmin},{Roles.HeadTeacher},{Roles.Teacher}")">
        <Authorized>
            <RadzenPanelMenuItem Text="Attendance" Icon="event_available" Expanded="true">
                <RadzenPanelMenuItem Text="Daily attendance" Icon="today" Path="/attendance/daily" />
                <RadzenPanelMenuItem Text="Subject attendance" Icon="schedule" Path="/attendance/subject" />
                <RadzenPanelMenuItem Text="Summary" Icon="analytics" Path="/attendance/summary" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.SuperAdmin},{Roles.HeadTeacher},{Roles.Teacher}")">
        <Authorized>
            <RadzenPanelMenuItem Text="Results & Reports" Icon="assignment" Expanded="true">
                <RadzenPanelMenuItem Text="Assessments" Icon="grading" Path="/assessments" />
                <RadzenPanelMenuItem Text="Subject results" Icon="leaderboard" Path="/results" />
                <RadzenPanelMenuItem Text="Report cards" Icon="description" Path="/reports" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.SuperAdmin},{Roles.HeadTeacher},{Roles.SchoolBursar}")">
        <Authorized>
            <RadzenPanelMenuItem Text="Finance" Icon="payments" Expanded="true">
                <RadzenPanelMenuItem Text="Bursar dashboard" Icon="space_dashboard" Path="/finance" />
                <RadzenPanelMenuItem Text="Fee schedules" Icon="receipt_long" Path="/fees" />
                <RadzenPanelMenuItem Text="Invoices" Icon="request_quote" Path="/invoices" />
                <RadzenPanelMenuItem Text="Issue invoices" Icon="post_add" Path="/invoices/issue" />
                <RadzenPanelMenuItem Text="Payments" Icon="payments" Path="/payments" />
                <RadzenPanelMenuItem Text="Record payment" Icon="add_card" Path="/payments/new" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.SuperAdmin},{Roles.HeadTeacher},{Roles.SchoolStoreKeeper}")">
        <Authorized>
            <RadzenPanelMenuItem Text="Store & Inventory" Icon="inventory_2" Expanded="true">
                <RadzenPanelMenuItem Text="Store dashboard" Icon="space_dashboard" Path="/store" />
                <RadzenPanelMenuItem Text="Catalog" Icon="inventory_2" Path="/store/items" />
                <RadzenPanelMenuItem Text="New item" Icon="add_box" Path="/store/items/new" />
                <RadzenPanelMenuItem Text="Movements" Icon="swap_vert" Path="/store/movements" />
                <RadzenPanelMenuItem Text="Record movement" Icon="post_add" Path="/store/movements/new" />
                <RadzenPanelMenuItem Text="Suppliers" Icon="local_shipping" Path="/store/suppliers" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@($"{Roles.SuperAdmin},{Roles.HeadTeacher}")">
        <Authorized>
            <RadzenPanelMenuItem Text="Communications" Icon="campaign" Expanded="true">
                <RadzenPanelMenuItem Text="Announcements" Icon="campaign" Path="/announcements" />
                <RadzenPanelMenuItem Text="New announcement" Icon="add" Path="/announcements/new" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@(Roles.Parent)">
        <Authorized>
            <RadzenPanelMenuItem Text="Parent portal" Icon="family_restroom" Expanded="true">
                <RadzenPanelMenuItem Text="My wards" Icon="groups" Path="/portal/parent" />
                <RadzenPanelMenuItem Text="Announcements" Icon="campaign" Path="/portal/announcements" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="@(Roles.Student)">
        <Authorized>
            <RadzenPanelMenuItem Text="Student portal" Icon="school" Expanded="true">
                <RadzenPanelMenuItem Text="Today" Icon="today" Path="/portal/student" />
                <RadzenPanelMenuItem Text="My profile" Icon="person" Path="/portal/student/profile" />
                <RadzenPanelMenuItem Text="My results" Icon="grading" Path="/portal/student/results" />
                <RadzenPanelMenuItem Text="My attendance" Icon="event_available" Path="/portal/student/attendance" />
                <RadzenPanelMenuItem Text="My fees" Icon="payments" Path="/portal/student/fees" />
                <RadzenPanelMenuItem Text="Announcements" Icon="campaign" Path="/portal/announcements" />
            </RadzenPanelMenuItem>
        </Authorized>
    </AuthorizeView>
</RadzenPanelMenu>
