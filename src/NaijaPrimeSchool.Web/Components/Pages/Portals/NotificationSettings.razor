        <h1>Reminder settings</h1>
        <p>Choose whether the school may email or text you about unread announcements and new messages from the office, and when.</p>
    </div>
</div>

<RadzenCard class="nps-card" Style="max-width: 860px;">
    <NotificationPreferencesEditor />
</RadzenCard>
