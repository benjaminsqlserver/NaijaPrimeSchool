@page "/portal/notifications"
@attribute [Authorize(Roles = $"{Roles.Parent},{Roles.Student}")]
@rendermode InteractiveServer

<PageTitle>Reminder settings · Naija Prime School</PageTitle>

<div class="nps-page-header">
